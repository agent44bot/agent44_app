<% content_for :title, "Link not recognized" %>

<section class="bg-gray-950 min-h-screen">
  <div class="max-w-lg mx-auto px-4 py-16">
    <h1 class="text-2xl font-black text-white tracking-tight">We couldn't read that link</h1>
    <p class="mt-3 text-[15px] text-gray-300 leading-relaxed">
      The unsubscribe link looks incomplete, which usually means an email client
      split it across lines. You can turn these emails off yourself in Settings
      under Notifications, or reply to the email and we'll do it for you.
    </p>

    <%= link_to "Go to Settings", settings_path,
          class: "inline-block mt-6 px-4 py-3 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-sm font-semibold" %>
  </div>
</section>
