#!/usr/bin/env bash
# The Mac mini feedback agent (docs/feedback_pipeline.md).
#
#   bin/feedback-agent            # run forever (what launchd does)
#   bin/feedback-agent --once     # one pass over the queue, then exit
#   bin/feedback-agent install    # install + start the launchd agent
#   bin/feedback-agent uninstall  # stop + remove it
#
# API_TOKEN is fetched from the Fly app at start, like bin/smoke.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LABEL="ai.agent44.feedback-agent"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="$HOME/.feedback-agent"

case "${1:-}" in
  install)
    mkdir -p "$LOG_DIR"
    sed -e "s#__ROOT__#$ROOT#g" -e "s#__HOME__#$HOME#g" "$ROOT/config/launchd/$LABEL.plist" > "$PLIST"
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "installed $LABEL; logs in $LOG_DIR/agent.log"
    exit 0 ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    echo "removed $LABEL"
    exit 0 ;;
esac

# rvm's scripts aren't written for `set -u`.
set +u
[[ -s "$HOME/.rvm/scripts/rvm" ]] && source "$HOME/.rvm/scripts/rvm"
set -u
export PATH="$HOME/.local/bin:$HOME/.fly/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# launchd starts with no locale; without UTF-8, Ruby reads feedback text as
# US-ASCII and chokes on the first curly quote or emoji.
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# The live API token, fetched from the Fly app at start like bin/smoke does
# (so nothing sits on disk, and it can't go stale). $API_TOKEN wins if set.
if [[ -z "${API_TOKEN:-}" ]]; then
  API_TOKEN="$(fly ssh console -C 'printenv API_TOKEN' --app agent44-app 2>/dev/null | tr -d '\r\n')"
fi
if [[ -z "${API_TOKEN:-}" ]]; then
  echo "ERROR: could not fetch API_TOKEN from Fly (is 'fly auth' current?)" >&2
  exit 1
fi
export API_TOKEN
exec ruby "$ROOT/bin/feedback_agent_loop.rb" "$@"
