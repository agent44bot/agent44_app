<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `bin/feedback-agent install` (__ROOT__ and __HOME__ are filled in). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.agent44.feedback-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/bin/feedback-agent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.feedback-agent/agent.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.feedback-agent/agent.log</string>
</dict>
</plist>
