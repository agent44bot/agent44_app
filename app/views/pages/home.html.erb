<%# No title override — defaults to "Agent44 Labs" %>

<!-- Hero Section -->
<section class="relative overflow-hidden bg-black border-b border-gray-800">
  <%# The logo is the only visual in the hero. Keeping it behind the copy makes
      the brand unmistakable without competing with the primary action. %>
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 h-px bg-orange-500"></div>
    <img src="/icon.png?v=3" alt="" width="512" height="512"
         class="absolute left-1/2 top-3 h-64 w-64 -translate-x-1/2 select-none object-contain lg:left-auto lg:right-[3%] lg:top-[-1rem] lg:h-[38rem] lg:w-[38rem] lg:translate-x-0">
  </div>

  <div class="relative mx-auto flex min-h-[580px] max-w-7xl flex-col justify-end px-4 pb-10 pt-64 sm:min-h-[620px] sm:px-6 sm:pb-14 lg:px-8 lg:pt-20">
    <div class="max-w-3xl text-left">
      <div class="mb-5 flex items-center gap-3 font-mono text-xs font-bold uppercase text-orange-500">
        <span class="h-0.5 w-10 bg-orange-500"></span>
        <span>Agent44 Labs</span>
      </div>
      <div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-[1.05]">
          Building agents<br><span class="text-orange-500">for business and <br>everyday life.</span>
        </h1>

        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-gray-300 leading-relaxed max-w-xl">
          Specialists that monitor your site, watch your data, publish your content, and keep you briefed, so you never have to check in.
        </p>

        <%# Face ID — banking-pattern auto-prompt on app launch. Returning iOS
            users with stored credentials get signed in before they see this
            page. The manual sign-in button lives on /session/new for users
            who land there explicitly. No visible affordance on the hero. %>
        <% unless authenticated? %>
          <%= render "shared/faceid_auth" %>
        <% end %>

        <%# Download CTA — App Store badge + a height-matched scan-to-visit QR
            beside it on large screens. Badge is js-web-only (hidden in the
            native app); smaller screens keep the hero compact. %>
        <div class="mt-6 sm:mt-8 flex items-center gap-4">
          <%= render "shared/app_store_badge" %>
          <div class="hidden lg:block">
            <%= render "shared/qr_code_inline" %>
          </div>
        </div>

        <% if false # Hidden for now — bring back later %>
        <div class="mt-6 sm:mt-8 flex flex-col items-start justify-start gap-4">
          <%# Face ID button — shown on mobile native when available %>
          <button type="button" id="faceid-signin-btn" style="display:none"
                  class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-orange-600 to-amber-600 rounded-full hover:from-orange-700 hover:to-amber-700 transition shadow-lg shadow-orange-600/30 sm:hidden">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7V5a2 2 0 012-2h2M17 3h2a2 2 0 012 2v2M3 17v2a2 2 0 002 2h2M17 21h2a2 2 0 002-2v-2M8 11v1M16 11v1M9 16c.5.5 1.5 1 3 1s2.5-.5 3-1M12 8v5"/>
            </svg>
            <span class="faceid-label">Sign in with Face ID</span>
          </button>
          <%= render "shared/faceid_auth" %>
          <div class="flex flex-wrap items-center justify-start gap-3">
            <a href="#case-studies"
               class="inline-flex items-center px-4 sm:px-6 py-2 sm:py-3 text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-orange-600 to-amber-600 rounded-full hover:from-orange-700 hover:to-amber-700 transition shadow-lg shadow-orange-600/30">
              See a live test →
            </a>
            <a href="mailto:botwhisperer@hey.com?subject=Agent%2044%20Labs%20%E2%80%94%20QA%20for%20my%20site"
               class="inline-flex items-center px-4 sm:px-6 py-2 sm:py-3 text-xs sm:text-sm font-semibold text-white bg-gray-800 rounded-full hover:bg-gray-700 transition border border-gray-700">
              Get a quote
            </a>
          </div>
        </div>
        <% end %>
      </div>

    </div>
  </div>
</section>

<!-- How it works -->
<section id="how-it-works" class="border-t border-gray-800 bg-gray-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="mb-12 sm:mb-16">
      <p class="text-xs font-mono uppercase tracking-[0.2em] text-orange-400 mb-2">How it works</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        From signup to working agents in <span class="text-orange-500">under a minute</span>.
      </h2>
      <p class="mt-3 text-base text-gray-400 max-w-2xl">
        A typical workspace runs four always-on agents that watch the site, snapshot data, post to social, and smoke-test critical flows, 24/7, for pennies a day.
      </p>
    </div>

    <% phone_frame   = "max-w-[260px] mx-auto rounded-[2rem] border border-gray-800 bg-gray-900 overflow-hidden shadow-2xl shadow-black/40" %>
    <% phone_image   = "w-full h-auto block" %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
      <!-- Step 1: Plug in -->
      <div class="relative">
        <div class="flex items-baseline gap-3 mb-3">
          <span class="text-2xl font-black text-orange-500 font-mono">01</span>
          <h3 class="text-lg sm:text-xl font-bold text-white">Plug in your business</h3>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-5">
          Sign up, name your workspace, connect the accounts you want agents to work in (X, Bluesky, Threads, Facebook). 60 seconds.
        </p>
      </div>

      <!-- Step 2: They work 24/7 -->
      <div class="relative">
        <div class="flex items-baseline gap-3 mb-3">
          <span class="text-2xl font-black text-orange-500 font-mono">02</span>
          <h3 class="text-lg sm:text-xl font-bold text-white">They work 24/7</h3>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-5">
          Agents run on their own cadence: scrape every few hours, smoke-test hourly, draft and post on schedule. You see green dots when everything's healthy.
        </p>
      </div>

      <!-- Step 3: Real results -->
      <div class="relative">
        <div class="flex items-baseline gap-3 mb-3">
          <span class="text-2xl font-black text-orange-500 font-mono">03</span>
          <h3 class="text-lg sm:text-xl font-bold text-white">Real results, live</h3>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-5">
          Sales tracked, posts published, regressions caught. Your own numbers, updated as the agents work.
        </p>
      </div>
    </div>

    <div class="mt-12 sm:mt-16 flex justify-center">
      <div class="<%= phone_frame %> max-w-[260px]">
        <%= image_tag "marketing/iphone-home.png", alt: "Agent44 Labs on iPhone with a live fleet of agents", class: phone_image %>
      </div>
    </div>

    <div class="mt-12 sm:mt-16 text-center">
      <a href="<%= new_registration_path %>" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-gray-800 rounded-full hover:bg-gray-700 transition border border-gray-700">
        Start your workspace
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>


<%# QR Code — mobile only, pinned at the very bottom of the page. Scroll down
    and show your phone to another phone to scan: /get routes iPhones to the
    App Store, everyone else to the website. Desktop shows the QR in the hero
    sidebar instead.
    Visibility: on the web it shows for everyone (js-web-only, stripped inside
    the native app). For the site admin (botwhisperer) we DROP js-web-only so it
    also survives inside the iOS app — a personal "scan my screen to grab the
    app" tool for sharing with friends. Other app users (e.g. Lora) don't see
    it in-app. %>
<section class="sm:hidden border-t border-gray-800 <%= "js-web-only" unless Current.user&.admin? %>">
  <div class="px-6 py-10 flex justify-center">
    <%= render "shared/qr_code_hero" %>
  </div>
</section>

<% if false # Hidden for now — bring back later %>
<!-- Contact CTA -->
<section class="border-t border-gray-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white">Got a production site worth watching?</h2>
    <p class="mt-3 text-gray-500 max-w-md mx-auto">
      Tell us your critical flow. We'll build the smoke test and show you what it catches.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="mailto:botwhisperer@hey.com?subject=Agent%2044%20Labs%20%E2%80%94%20QA%20for%20my%20site"
         class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-orange-600 to-amber-600 rounded-full hover:from-orange-700 hover:to-amber-700 transition shadow-lg shadow-orange-600/30">
        Get a quote
      </a>
      <a href="#case-studies"
         class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-gray-800 rounded-full hover:bg-gray-700 transition border border-gray-700">
        See a live test
      </a>
    </div>
    <div class="mt-12 max-w-md mx-auto" id="home-newsletter-form">
      <p class="text-xs text-gray-600 mb-3">Or just watch along — occasional updates on new tests and tooling.</p>
      <%= render "subscribers/form" %>
    </div>
  </div>
</section>
<% end %>

<%# The App Store badge is meaningless inside the native app — strip any
    .js-web-only elements when we're running in the Capacitor shell. Runs on
    initial load and on every Turbo render so post-navigation returns stay clean. %>
<%= javascript_tag nonce: true do %>
(function() {
  if (!window.Capacitor || !window.Capacitor.isNativePlatform()) return;
  function hideWebOnly() {
    document.querySelectorAll('.js-web-only').forEach(function(el) { el.remove(); });
  }
  hideWebOnly();
  document.addEventListener('turbo:load', hideWebOnly);
  document.addEventListener('turbo:render', hideWebOnly);
})();
<% end %>
