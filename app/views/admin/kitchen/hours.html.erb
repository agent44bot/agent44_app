<% content_for :title, "NY Kitchen: Team hours" %>

<div class="max-w-3xl mx-auto px-4 py-6 text-gray-200">
  <%= render "admin/kitchen/breadcrumbs", current: "Team hours" %>

  <div class="flex items-start justify-between gap-4 mb-1">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-white">Team hours</h1>
      <p class="text-sm text-gray-400 mt-1">Scheduled hours per employee, by week, from Deputy.</p>
    </div>
    <% if @hours %>
      <%= link_to nyk_hours_path(week: @week_start, xlsx: 1),
            data: { turbo_frame: "_top" },
            class: "shrink-0 inline-flex items-center gap-2 rounded-lg bg-green-600 hover:bg-green-500 px-3 py-2 text-sm font-semibold text-white transition" do %>
        <span aria-hidden="true">⬇</span><span>Export to Excel</span>
      <% end %>
    <% end %>
  </div>

  <%# Week navigation: prev / label / next (next disabled once we reach this week) %>
  <div class="flex items-center justify-between gap-3 my-5 rounded-xl border border-gray-700 bg-gray-800/40 px-3 py-2">
    <%= link_to nyk_hours_path(week: @prev_week_start),
          class: "inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition" do %>
      <span aria-hidden="true">←</span><span>Prev week</span>
    <% end %>
    <div class="text-center">
      <div class="text-sm font-semibold text-white">
        <%= @week_start.strftime("%b %-d") %> &ndash; <%= @week_end.strftime("%b %-d, %Y") %>
      </div>
      <div class="text-xs text-gray-500">Mon &ndash; Sun</div>
    </div>
    <% if @has_next %>
      <%= link_to nyk_hours_path(week: @next_week_start),
            class: "inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition" do %>
        <span>Next week</span><span aria-hidden="true">→</span>
      <% end %>
    <% else %>
      <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-gray-600 cursor-not-allowed">
        <span>Next week</span><span aria-hidden="true">→</span>
      </span>
    <% end %>
  </div>

  <%# Timesheets: generate this week's shifts into Deputy as pending timesheets,
      or (if some already exist) link to review them. Never touches the schedule. %>
  <% if @hours %>
    <div class="mb-5 rounded-xl border border-gray-700 bg-gray-800/40 px-4 py-3">
      <% if @timesheet_count.to_i.positive? %>
        <div class="flex items-center justify-between gap-3">
          <div class="text-sm text-gray-300">
            <span class="font-semibold text-white"><%= @timesheet_count %></span>
            timesheet<%= "s" unless @timesheet_count == 1 %> generated for this week in Deputy.
            <% if @timesheet_status %>
              <span class="text-green-400 font-medium"><%= @timesheet_status[:approved] %> approved</span>,
              <span class="text-amber-400 font-medium"><%= @timesheet_status[:pending] %> pending</span>.
            <% end %>
          </div>
          <%= link_to @deputy_approve_url, target: "_blank", rel: "noopener",
                class: "shrink-0 inline-flex items-center gap-2 rounded-lg bg-blue-600 hover:bg-blue-500 px-3 py-2 text-sm font-semibold text-white transition" do %>
            <span>Review in Deputy</span><span aria-hidden="true">→</span>
          <% end %>
        </div>
        <p class="mt-1.5 text-xs text-gray-500">In Deputy: Timesheets, Approve Timesheets, then set the week and location (Culinary or Beverage Team Schedule) and approve.</p>
      <% else %>
        <div class="flex items-center justify-between gap-3">
          <div class="text-sm text-gray-300">Turn this week's schedule into timesheets in Deputy, created as pending for you to approve.</div>
          <%= button_to nyk_generate_timesheets_path(week: @week_start),
                form_class: "shrink-0",
                data: { turbo_confirm: "Create a pending timesheet for each scheduled shift the week of #{@week_start.strftime('%b %-d')}? They are created unapproved in Deputy for you to review. This does not change your schedule." },
                class: "inline-flex items-center gap-2 rounded-lg bg-orange-600 hover:bg-orange-500 px-3 py-2 text-sm font-semibold text-white transition" do %>
            <span aria-hidden="true">🕐</span><span>Generate timesheets</span>
          <% end %>
        </div>
        <p class="mt-1.5 text-xs text-gray-500">One timesheet per scheduled shift. It never changes your schedule, and does nothing if timesheets already exist for the week.</p>
      <% end %>
    </div>
  <% end %>

  <% if @hours_error %>
    <div class="rounded-xl border border-amber-700/50 bg-amber-900/20 px-4 py-3 text-sm text-amber-200">
      Could not load hours: <%= @hours_error %>
    </div>
  <% elsif @hours.nil? %>
    <div class="rounded-xl border border-gray-700 bg-gray-800/40 px-4 py-6 text-center text-gray-400">Loading…</div>
  <% elsif @hours[:rows].empty? %>
    <div class="rounded-xl border border-gray-700 bg-gray-800/40 px-4 py-6 text-center text-gray-400">
      No scheduled shifts for this week.
    </div>
  <% else %>
    <%# Status column appears once timesheets exist for the week; before that,
        the Generate button above is the call to action, so the column is hidden. %>
    <% show_status = @timesheet_count.to_i.positive? && @timesheet_status %>
    <div class="overflow-hidden rounded-xl border border-gray-700">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-800 text-gray-400 text-left">
            <th class="px-4 py-2 font-medium">Employee</th>
            <% if show_status %><th class="px-4 py-2 font-medium">Timesheet</th><% end %>
            <th class="px-4 py-2 font-medium text-right">Hours</th>
            <th class="px-4 py-2 font-medium text-right w-24">Decimal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% @hours[:rows].each do |r| %>
            <tr class="bg-gray-900/40 hover:bg-gray-800/60 transition">
              <td class="px-4 py-2 text-gray-100"><%= r[:employee] %></td>
              <% if show_status %>
                <td class="px-4 py-2">
                  <% st = @timesheet_status[:by_employee][r[:employee]] %>
                  <% if st.nil? %>
                    <span class="text-xs text-gray-600">not generated</span>
                  <% elsif st[:pending].zero? %>
                    <span class="inline-flex items-center rounded-full bg-green-900/40 text-green-300 px-2 py-0.5 text-xs font-medium">Approved</span>
                  <% elsif st[:approved].zero? %>
                    <span class="inline-flex items-center rounded-full bg-amber-900/40 text-amber-300 px-2 py-0.5 text-xs font-medium">Pending</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-blue-900/40 text-blue-300 px-2 py-0.5 text-xs font-medium">Mixed <%= st[:approved] %>/<%= st[:total] %></span>
                  <% end %>
                </td>
              <% end %>
              <td class="px-4 py-2 text-right tabular-nums text-gray-100"><%= NykHoursXlsx.hm(r[:hours]) %></td>
              <td class="px-4 py-2 text-right tabular-nums text-gray-400"><%= "%.2f" % r[:hours] %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-gray-800 font-semibold text-white">
            <td class="px-4 py-2">Total &middot; <%= @hours[:rows].size %> staff</td>
            <% if show_status %><td class="px-4 py-2"></td><% end %>
            <td class="px-4 py-2 text-right tabular-nums"><%= NykHoursXlsx.hm(@hours[:total]) %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= "%.2f" % @hours[:total] %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <% if @hours[:open_hours].to_f > 0 %>
      <p class="mt-3 text-xs text-gray-500">
        Plus <span class="text-gray-300 font-medium"><%= NykHoursXlsx.hm(@hours[:open_hours]) %></span>
        of unfilled open shifts (not assigned to anyone, excluded from the total above).
      </p>
    <% end %>

    <% if @hours[:by_area].present? %>
      <div class="mt-6">
        <h2 class="text-xs uppercase tracking-wide text-gray-500 mb-2">By area</h2>
        <div class="flex flex-wrap gap-2">
          <% @hours[:by_area].each do |area, hrs| %>
            <span class="rounded-full border border-gray-700 bg-gray-800/40 px-3 py-1 text-xs text-gray-300">
              <%= area %> <span class="text-gray-500"><%= NykHoursXlsx.hm(hrs) %></span>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="mt-6 text-xs text-gray-600">
      These are scheduled hours from Deputy (<%= @hours[:shift_count] %> shifts this week), not clocked timesheets.
    </p>
  <% end %>
</div>
