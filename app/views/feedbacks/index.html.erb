<% content_for :title, "Your feedback" %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Your feedback</h1>
      <p class="text-sm text-gray-400 mt-1">What you've sent and where each one stands.</p>
    </div>
    <%= link_to "Send feedback", new_feedback_path,
          class: "shrink-0 inline-flex items-center px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold" %>
  </div>

  <% if @feedbacks.empty? %>
    <div class="rounded-lg bg-gray-900 border border-gray-800 p-8 text-center">
      <p class="text-gray-400">Nothing sent yet.</p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @feedbacks.each do |fb| %>
        <div id="<%= dom_id(fb) %>" class="rounded-lg bg-gray-900 border border-gray-800 p-4">
          <div class="flex items-center justify-between gap-3 mb-2">
            <span class="text-xs text-gray-500"><%= fb.created_at.strftime("%b %-d, %Y %-l:%M %p") %></span>
            <%= render "feedbacks/status_badge", feedback: fb %>
          </div>
          <p class="text-sm text-gray-200 whitespace-pre-line"><%= fb.message %></p>
          <% if fb.attachments.attached? %>
            <p class="text-xs text-gray-500 mt-2"><%= pluralize(fb.attachments.size, "file") %> attached</p>
          <% end %>
          <% if fb.status == "needs_info" && (q = fb.thread.reverse.find { |t| t["kind"] == "question" }) %>
            <div class="mt-3 rounded-md border border-orange-800 bg-orange-950/30 px-3 py-2">
              <p class="text-xs font-semibold text-orange-300">Rich asked:</p>
              <p class="text-sm text-gray-100 whitespace-pre-line mt-0.5"><%= q["body"] %></p>
              <%= form_with url: answer_feedback_path(fb), method: :post, class: "mt-2 space-y-2" do %>
                <%= text_area_tag :answer, nil, rows: 3, required: true,
                      placeholder: "Your answer",
                      class: "w-full rounded-lg bg-gray-950 border border-gray-700 text-gray-100 text-base px-3 py-2 focus:border-orange-500 focus:outline-none" %>
                <%= submit_tag "Send answer", data: { disable_with: "Sending..." },
                      class: "px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold cursor-pointer" %>
              <% end %>
            </div>
          <% end %>
          <% if fb.reply.present? %>
            <div class="mt-3 rounded-md border border-gray-800 bg-gray-950 px-3 py-2 text-sm text-gray-300">
              <span class="text-xs font-semibold text-orange-400">Rich:</span> <%= fb.reply %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
