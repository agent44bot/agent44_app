<% content_for :title, "Feedback board" %>
<%# Columns on desktop; stacked on a phone, with the two stages waiting on
    Rich (Review PR, Pre-dev) first. %>
<% mobile_order = { "review_pr" => "order-1", "pre_dev" => "order-2", "dev" => "order-3",
                    "post_dev" => "order-4", "deploy" => "order-5", "done" => "order-6" } %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Feedback board</h1>
      <p class="text-sm text-gray-400 mt-1">
        <% if @waiting_count.positive? %>
          <span class="text-orange-400 font-semibold"><%= pluralize(@waiting_count, "item") %> waiting on you</span>
        <% else %>
          Nothing waiting on you
        <% end %>
      </p>
    </div>
    <%= link_to "+ New item", new_admin_feedback_path,
          class: "inline-flex items-center px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold" %>
  </div>

  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-6 lg:gap-3 lg:items-start">
    <% @columns.each do |stage, items| %>
      <section class="<%= mobile_order[stage] %> lg:order-none rounded-xl bg-gray-900/60 border border-gray-800 p-3 min-w-0" id="stage-<%= stage %>">
        <h2 class="flex items-center justify-between text-xs font-bold uppercase tracking-wide text-gray-400 mb-2 px-1">
          <span><%= Feedback::STAGES[stage] %></span>
          <span class="text-gray-500"><%= items.size %><%= "+" if stage == "done" && items.size >= Admin::FeedbacksController::DONE_SHOWN %></span>
        </h2>
        <% if items.empty? %>
          <p class="text-xs text-gray-600 px-1 py-2">Empty</p>
        <% end %>
        <div class="space-y-2">
          <% items.each do |fb| %>
            <%= link_to admin_feedback_path(fb), id: dom_id(fb),
                  class: "block rounded-lg bg-gray-900 border p-3 hover:border-orange-500 transition #{fb.stuck? ? 'border-red-700' : (fb.waiting_on_rich? ? 'border-orange-600' : 'border-gray-700')}" do %>
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-xs font-semibold text-white truncate"><%= fb.user.display_identifier %></span>
                <span class="text-[11px] text-gray-500 shrink-0"><%= fb.created_at.strftime("%b %-d") %></span>
              </div>
              <p class="text-sm text-gray-300 leading-snug"><%= fb.excerpt(90) %></p>
              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <% if fb.stuck? %>
                  <span class="text-[11px] font-semibold text-red-400">Stuck</span>
                <% else %>
                  <%= render "feedbacks/status_badge", feedback: fb, label: fb.status_label %>
                <% end %>
                <% if fb.attachments.attached? %><span class="text-[11px] text-gray-500">📎 <%= fb.attachments.size %></span><% end %>
                <% if fb.pr_number %><span class="text-[11px] text-gray-500">PR #<%= fb.pr_number %></span><% end %>
                <% if fb.security_sensitive? %><span class="text-[11px] font-semibold text-red-400">Security</span><% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
