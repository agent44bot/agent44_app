<% content_for :title, "Feedback" %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Feedback</h1>
      <p class="text-sm text-gray-400 mt-1"><%= pluralize(@open_count, "open item") %></p>
    </div>
    <div class="flex flex-wrap gap-2 text-sm">
      <%= link_to "All", admin_feedbacks_path, class: "px-3 py-1 rounded-full border #{@status ? 'border-gray-700 text-gray-400' : 'border-orange-500 text-orange-300'}" %>
      <% %w[planned pr_ready needs_info shipped closed].each do |s| %>
        <%= link_to Feedback::LABELS[s], admin_feedbacks_path(status: s), class: "px-3 py-1 rounded-full border #{@status == s ? 'border-orange-500 text-orange-300' : 'border-gray-700 text-gray-400'}" %>
      <% end %>
    </div>
  </div>

  <% if @feedbacks.empty? %>
    <div class="rounded-lg bg-gray-900 border border-gray-700 p-8 text-center">
      <p class="text-gray-400">No feedback here.</p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @feedbacks.each do |fb| %>
        <%= link_to admin_feedback_path(fb), id: dom_id(fb),
              class: "block rounded-lg bg-gray-900 border #{fb.stuck? ? 'border-red-700' : 'border-gray-700'} p-4 hover:border-orange-500 transition" do %>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <div class="text-sm">
              <span class="font-semibold text-white"><%= fb.user.display_identifier %></span>
              <% if fb.workspace %><span class="text-gray-500"> · <%= fb.workspace.name %></span><% end %>
              <span class="text-gray-500"> · <%= fb.created_at.strftime("%b %-d, %-l:%M %p") %></span>
            </div>
            <span class="flex items-center gap-2">
              <% if fb.stuck? %><span class="text-xs font-semibold text-red-400">Stuck</span><% end %>
              <%= render "feedbacks/status_badge", feedback: fb, label: fb.status_label %>
            </span>
          </div>
          <p class="text-sm text-gray-300"><%= fb.excerpt(160) %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
