<%# Orange = someone needs to act (Rich on a plan or PR, the sender on a
    question); the sender only ever sees their own labels. %>
<% label = local_assigns[:label] || feedback.sender_status_label %>
<% color = case label
           when "Live" then "bg-emerald-950/60 text-emerald-300 border-emerald-800"
           when "Closed" then "bg-gray-900 text-gray-500 border-gray-800"
           when "Received" then "bg-gray-800 text-gray-300 border-gray-700"
           when "Plan ready", "Ready to merge", "Question for you" then "bg-orange-950/60 text-orange-300 border-orange-800"
           else "bg-amber-950/60 text-amber-300 border-amber-800"
           end %>
<span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full border <%= color %>"><%= label %></span>
