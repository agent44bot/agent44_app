<% content_for :title, "Echo emails are off" %>

<section class="bg-gray-950 min-h-screen">
  <div class="max-w-lg mx-auto px-4 py-16">
    <h1 class="text-2xl font-black text-white tracking-tight">Done, these emails are off</h1>
    <p class="mt-3 text-[15px] text-gray-300 leading-relaxed">
      <%= @membership.user.email_address %> will no longer get the daily Echo email for
      <%= @membership.workspace.name %>. You can turn it back on any time in
      Settings under Notifications.
    </p>

    <%= link_to "Go to Settings", settings_path,
          class: "inline-block mt-6 px-4 py-3 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-sm font-semibold" %>
  </div>
</section>
